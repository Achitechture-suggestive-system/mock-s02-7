{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/architecture-context-mock/retrieval-evidence.schema.json",
  "title": "Architecture Context Retrieval Evidence",
  "type": "object",
  "required": ["schema_version", "query_case_id", "index_id", "method", "queries", "retrieved_cases", "exclusions"],
  "properties": {
    "schema_version": {"const": "0.1.0-mock"},
    "query_case_id": {"type": "string"},
    "index_id": {"type": "string"},
    "index_version": {"type": "string"},
    "index_generated_at": {"type": "string"},
    "method": {"type": "object"},
    "query_policy": {"type": "object"},
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query_id", "requirement_id", "query_text", "rag_eligible", "evidence"],
        "properties": {
          "query_id": {"type": "string"},
          "requirement_id": {"type": "string"},
          "query_kind": {"type": "string"},
          "query_text": {"type": "string"},
          "source_refs": {"type": "array"},
          "rag_eligible": {"type": "boolean"},
          "leakage": {"type": "object"},
          "query_tokens": {"type": "array", "items": {"type": "string"}},
          "audit_content_terms": {"type": "array", "items": {"type": "string"}},
          "audit_known_content_terms": {"type": "array", "items": {"type": "string"}},
          "audit_oov_content_terms": {"type": "array", "items": {"type": "string"}},
          "support_status": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rank", "evidence_id", "case_id", "evidence_type", "text", "rrf_rank", "rrf_score", "source_path", "source_locator"],
              "properties": {
                "rank": {"type": "integer", "minimum": 1},
                "evidence_id": {"type": "string"},
                "requirement_id": {"type": ["string", "null"]},
                "case_id": {"type": "string"},
                "evidence_type": {"type": "string"},
                "text": {"type": "string"},
                "lexical_rank": {"type": ["integer", "null"], "minimum": 1},
                "lexical_score": {"type": ["number", "null"]},
                "semantic_rank": {"type": ["integer", "null"], "minimum": 1},
                "semantic_score": {"type": ["number", "null"]},
                "rrf_rank": {"type": "integer", "minimum": 1},
                "rrf_score": {"type": "number"},
                "reranker_rank": {"type": ["integer", "null"], "minimum": 1},
                "reranker_score": {"type": ["number", "null"]},
                "matched_terms": {"type": "array", "items": {"type": "string"}},
                "matched_content_terms": {"type": "array", "items": {"type": "string"}},
                "source_path": {"type": "string"},
                "source_locator": {"type": ["string", "null"]},
                "review_status": {"type": ["string", "null"]},
                "evidence_tier": {"type": ["string", "null"]},
                "provenance": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "retrieved_cases": {"type": "array", "items": {"type": "object"}},
    "retrieval_audit": {"type": "object"},
    "exclusions": {
      "type": "object",
      "required": ["input_requirements", "kb_evidence"],
      "properties": {
        "input_requirements": {"type": "array"},
        "kb_evidence": {"type": "array"}
      }
    },
    "index_stats": {"type": "object"},
    "claim_boundary": {"type": "string"}
  }
}
